# URL et clé publique (publishable / anon) du projet Supabase — exposées au navigateur, protégées par la RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé service_role — SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_ ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique de l'application (liens d'invitation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
